{
	"name": "m4l-gugelhupf",
	"private": true,
	"version": "1.2.1",
	"type": "module",
	"packageManager": "pnpm@10.0.0",
	"license": "AGPL-3.0-or-later",
	"description": "Max for Live devices for Strudel - all of Strudel as a track's audio, live pattern evaluation to MIDI, a sample browser and an audio effects rack, built on M4L-JWEB",
	"scripts": {
		"dev": "node scripts/dev.mjs alienmind-gugelhupf-midi",
		"dev:midi": "node scripts/dev.mjs alienmind-gugelhupf-midi",
		"dev:drums-midi": "node scripts/dev.mjs alienmind-gugelhupf-drums-midi",
		"dev:sample-browser": "node scripts/dev.mjs alienmind-gugelhupf-sample-browser",
		"dev:fx": "node scripts/dev.mjs alienmind-gugelhupf-fx",
		"dev:drums-sampler": "node scripts/dev.mjs alienmind-gugelhupf-drums-sampler",
		"dev:strudel": "node scripts/dev.mjs alienmind-gugelhupf",
		"dev:synth": "node scripts/dev.mjs alienmind-gugelhupf-synth",
		"clean": "node scripts/clean-dist.mjs",
		"build": "node scripts/clean-dist.mjs && tsc -b && node scripts/build-repl.mjs --shim-only && node scripts/build-ui.mjs && m4l-jweb build",
		"build:repl": "node scripts/build-repl.mjs",
		"build:repl:overlay": "node scripts/build-repl.mjs --no-build",
		"build:repl:shim": "node scripts/build-repl.mjs --shim-only",
		"build:patchers": "m4l-jweb patchers",
		"build:install": "pnpm build && pnpm install:device",
		"install:device": "m4l-jweb install",
		"preview": "vite preview --host 127.0.0.1 --port 4175",
		"test": "vitest run",
		"format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"wrapper/**/*.ts\" \"scripts/*.mjs\""
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.460.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"tailwind-merge": "^2.5.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"devDependencies": {
		"@kabelsalat/lib": "^0.4.1",
		"@kabelsalat/web": "^0.4.1",
		"@m4l-jweb/bridge": "link:../m4l-jweb/packages/bridge",
		"@m4l-jweb/build": "link:../m4l-jweb/packages/build",
		"@m4l-jweb/surface": "link:../m4l-jweb/packages/surface",
		"@tailwindcss/vite": "^4.0.0",
		"@tonaljs/tonal": "^4.10.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"acorn": "^8.17.0",
		"chord-voicings": "^0.0.1",
		"esbuild": "^0.24.0",
		"escodegen": "^2.1.0",
		"estree-walker": "^3.0.3",
		"fraction.js": "^5.3.4",
		"nanostores": "^0.11.3",
		"prettier": "^3.4.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.7.0",
		"vite": "^6.0.0",
		"vite-plugin-singlefile": "^2.1.0",
		"vitest": "^2.1.0",
		"webmidi": "^3.1.16"
	}
}
